# Copiez ce fichier en « .env » (nom exact, à la racine du projet).
# .env est ignoré par git : votre clé ne sera jamais publiée.

# V3 : tous les rôles sont confiés par défaut à Claude Haiku via Claude Code (connectez-vous avec
# « claude auth login », compte claude.ai : consomme le quota de votre abonnement), avec le Qwen
# local en repli. Agent « claude_haiku » ; alias Claude Code du modèle :
# CLAUDE_HAIKU_MODEL=haiku

# Facultatif depuis la V3 : seulement si un rôle est confié à Gemini (AGENT_<ROLE>=gemini...).
# Google AI Studio > Clés API (niveau gratuit suffisant).
GEMINI_API_KEY=

# Modèle Gemini (niveau gratuit). Vérifiez son nom et ses limites dans AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Quotas appliqués par le limiteur (valeurs prudentes par défaut).
# GEMINI_MIN_INTERVAL_S=5        # 12 requêtes par minute
# GEMINI_DAILY_ALERT=1200
# GEMINI_DAILY_HARD_STOP=1400
# GEMINI_MAX_RETRIES=2

# Modèle local unique (Ollama) : replis, profils « données personnelles », masquage.
# Alignez-le sur « ollama list ». (QWEN_INTERFACE_MODEL / QWEN_FORMAT_MODEL de la V2 sont ignorées.)
# QWEN_MODEL=qwen3.5:9b-q4_K_M
# QWEN_NUM_CTX=16384
# OLLAMA_HOST_URL=http://localhost:11434
# Durée de maintien des modèles en VRAM après la dernière requête (défaut 2m ; 0 = déchargé aussitôt).
# Les modèles sont aussi déchargés à l'arrêt du programme (voir aussi liberer_vram.bat).
# LOCAL_KEEP_ALIVE=2m

# Grand modèle pour l'escalade : vide = agent du rôle grand_modele (claude_haiku par défaut),
# gemini (gratuit) ou claude (agent « claude », modèle CLAUDE_MODEL).
# claude = Claude Code connecté à VOTRE abonnement claude.ai (consomme son quota, pas l'API).
# BIG_MODEL_PROVIDER=
# CLAUDE_MODEL=sonnet
# CLAUDE_ALLOW_API_BILLING=0     # 1 seulement si vous acceptez une facturation API

# Agents interchangeables (agents.py). Entrée de test « gemini_test » : agent Gemini dont
# le modèle vient uniquement de cette variable (vide = agent indisponible). Ses appels
# passent par la même file et le même quota que les autres appels Gemini.
GEMINI_TEST_MODEL=
# Affectation d'un rôle à un autre agent (défaut V3 : claude_haiku puis repli qwen). Forme :
# AGENT_<ROLE>=agent[,repli...]   AGENT_<ROLE>_DIFFICILE=agent
# Agents : claude_haiku, qwen (local), gemini, gemini_test, claude, ou déclarés (AGENT_DECLARATIONS).
# Rôles : organisateur worker relecteur grand_modele interface cadrage routage promesse
#         format dedup reparation reformulation. Un rôle confié à Gemini ou Claude est un envoi
#         externe : écarté pour un profil « données personnelles » (le Qwen local le traite).
# Exemple « coût nul » : AGENT_ORGANISATEUR=gemini,qwen  AGENT_WORKER=gemini,qwen  AGENT_DEDUP=qwen
# Reformulation du texte libre (défaut : claude_haiku ; accord demandé une fois par session, il
# couvre aussi les autres rôles en texte libre de ce fournisseur ; texte masqué et contrôle de
# fuite avant chaque envoi). Valeur qwen = tout en local.
# AGENT_REFORMULATION=
# AGENT_SEUIL_CARACTERES=6000
# AGENT_SEUIL_SCORE=5
# AGENT_DECLARATIONS=

# Profil chargé au démarrage (dossier dans profiles/). Ensuite, le profil est choisi
# automatiquement d'après vos messages (/profil reste disponible).
# PROFILE=brainstorm
# Profil restrictif imposé dès qu'une donnée personnelle est détectée (aucun envoi externe).
# PROFIL_DONNEES_PERSO=bureautique_fictive

# Retours en langage libre : nombre de retours récents (garde/jette + raison, masqués)
# donnés en exemple à Qwen. 0 = désactivé. Jamais pour un profil « données personnelles ».
# FEEDBACK_EXEMPLES=5

# Revue, shortlist et escalade (à calibrer pendant le pilote).
# REVIEW_THRESHOLD=6.5
# SHORTLIST_MIN=5
# SHORTLIST_MAX=8
# CONTRARIAN_QUOTA=2
# COMPLEXITY_THRESHOLD=5
# DELEGATION_BUDGET=6
