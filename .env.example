# Copiez ce fichier en « .env » (nom exact, à la racine du projet) et renseignez votre clé.
# .env est ignoré par git : votre clé ne sera jamais publiée.

# Obligatoire. Google AI Studio > Clés API (niveau gratuit suffisant).
GEMINI_API_KEY=

# Modèle Gemini (niveau gratuit). Vérifiez son nom et ses limites dans AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Quotas appliqués par le limiteur (valeurs prudentes par défaut).
# GEMINI_MIN_INTERVAL_S=5        # 12 requêtes par minute
# GEMINI_DAILY_ALERT=1200
# GEMINI_DAILY_HARD_STOP=1400
# GEMINI_MAX_RETRIES=2

# Modèles locaux (Ollama). Alignez-les sur « ollama list ».
# QWEN_INTERFACE_MODEL=qwen3.5:4b-q8_0
# QWEN_FORMAT_MODEL=qwen2.5:3b-instruct-q4_K_M
# OLLAMA_HOST_URL=http://localhost:11434
# Durée de maintien des modèles en VRAM après la dernière requête (défaut 2m ; 0 = déchargé aussitôt).
# Les modèles sont aussi déchargés à l'arrêt du programme (voir aussi liberer_vram.bat).
# LOCAL_KEEP_ALIVE=2m

# Grand modèle pour l'escalade : gemini (gratuit) ou claude.
# claude = Claude Code connecté à VOTRE abonnement claude.ai (consomme son quota, pas l'API).
# BIG_MODEL_PROVIDER=gemini
# CLAUDE_MODEL=sonnet
# CLAUDE_ALLOW_API_BILLING=0     # 1 seulement si vous acceptez une facturation API

# Profil chargé au démarrage (dossier dans profiles/).
# PROFILE=brainstorm

# Revue, shortlist et escalade (à calibrer pendant le pilote).
# REVIEW_THRESHOLD=6.5
# SHORTLIST_MIN=5
# SHORTLIST_MAX=8
# CONTRARIAN_QUOTA=2
# COMPLEXITY_THRESHOLD=5
# DELEGATION_BUDGET=6
